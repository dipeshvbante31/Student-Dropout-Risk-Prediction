# Copy to .env and fill in. Never commit .env.
APP_ENV=development            # set to "production" on a server
SECRET_KEY=                    # required in production: python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=                  # production: postgresql://user:password@host:5432/dbname (empty = local SQLite)
MODEL_DIR=models
ALLOW_REGISTRATION=true        # set false after creating accounts
MAX_UPLOAD_MB=5
MAX_BATCH_ROWS=5000
RISK_LOW_MAX=0.40              # LOW below this probability
RISK_MEDIUM_MAX=0.70           # MEDIUM below this, HIGH at or above
SESSION_COOKIE_SECURE=         # defaults to true in production
LOG_LEVEL=INFO
DEVELOPER_NAME=Dipesh Vishnu Bante
DEVELOPER_EMAIL=dipeshbante31@gmail.com
DEVELOPER_GITHUB=https://github.com/dipeshvb31
DEVELOPER_INSTAGRAM=https://www.instagram.com/ok.dipesh/
